# Backend runtime settings. DATABASE_URL must point to the PostgreSQL database.
DATABASE_URL=postgresql://pos_admin:change-this-password@localhost:5433/pos_saas?schema=public
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3001
LANDING_PAGE_URL=
PORT=3000
BACKEND_ROUTE_PREFIX=

# Optional when provisioning the existing Toko Fajar tenant.
TOKO_FAJAR_TENANT_SLUG=toko-fajar
