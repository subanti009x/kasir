generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Multi-Tenant Core Models
// ------------------------------------------------------

model Tenant {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  logo            String?
  address         String?
  phone           String?
  email           String?
  businessHours   String?
  currency        String   @default("IDR")
  taxRate         Float    @default(0.0)
  receiptTemplate String?  @db.Text
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL
  plan            String   @default("BASIC")  // BASIC, GROWTH, ENTERPRISE
  planStartedAt   DateTime @default(now())
  planExpiresAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  products        Product[]
  categories      Category[]
  transactions    Transaction[]
  customers       Customer[]
  suppliers       Supplier[]
  inventoryLogs   InventoryLog[]
  purchaseOrders  PurchaseOrder[]
  paymentMethods  PaymentMethod[]
  planHistory      SubscriptionPlanHistory[]
  expenses        Expense[]
  journalEntries  JournalEntry[]
  tenantFeatures  TenantFeature[]
  whatsappConfig  WhatsappConfig?

  @@index([status])
  @@index([plan])
}

model SubscriptionPlanHistory {
  id          String   @id @default(uuid())
  plan        String
  previousPlan String?
  note        String?
  startsAt    DateTime @default(now())
  expiresAt   DateTime?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([plan])
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   // SUPER_ADMIN, OWNER, CASHIER
  status    String   @default("ACTIVE") // ACTIVE, INACTIVE
  avatar    String?

  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  expenses     Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([role])
}

// ------------------------------------------------------
// POS Entities (Scoped by Tenant)
// ------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products    Product[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String
  barcode       String?
  description   String?
  purchasePrice Float
  sellingPrice  Float
  stock         Int      @default(0)
  minStock      Int      @default(0)
  image         String?
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  inventoryLogs    InventoryLog[]
  transactionItems TransactionItem[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([categoryId])
}

model InventoryLog {
  id        String   @id @default(uuid())
  type      String   // STOCK_IN, STOCK_OUT, ADJUSTMENT
  quantity  Int
  note      String?
  reference String?  // e.g. Transaction ID or PO ID

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, createdAt])
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions   Transaction[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  contactPerson  String?

  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  purchaseOrders PurchaseOrder[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  orderNumber String
  status      String   @default("PENDING") // PENDING, RECEIVED, PARTIAL, CANCELLED
  totalAmount Float    @default(0)
  note        String?

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items       PurchaseOrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String   @id @default(uuid())
  quantity        Int
  unitCost        Float
  receivedQty     Int      @default(0)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model PaymentMethod {
  id        String   @id @default(uuid())
  name      String   // Cash, QRIS, Bank Transfer, E-Wallet, Split Payment
  enabled   Boolean  @default(true)

  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Transaction {
  id            String   @id @default(uuid())
  receiptId     String   @unique
  subtotal      Float
  discount      Float    @default(0.0)
  discountType  String?  // PERCENTAGE, FIXED
  tax           Float    @default(0.0)
  total         Float
  paymentMethod String   // Cash, QRIS, Bank Transfer, E-Wallet
  amountPaid    Float    @default(0)
  changeDue     Float    @default(0)
  status        String   @default("COMPLETED") // COMPLETED, REFUNDED, VOIDED
  note          String?

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cashierId     String
  cashier       User     @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items         TransactionItem[]
  payments      TransactionPayment[]
  whatsappLogs  WhatsappLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([cashierId])
  @@index([customerId])
}

model TransactionPayment {
  id            String   @id @default(uuid())
  method        String
  amount        Float
  reference     String?

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())

  @@index([transactionId])
}

model TransactionItem {
  id            String   @id @default(uuid())
  quantity      Int
  unitPrice     Float
  subtotal      Float

  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ------------------------------------------------------
// Accounting Models
// ------------------------------------------------------

model Expense {
  id          String   @id @default(uuid())
  category    String   // RENT, UTILITIES, SALARIES, MARKETING, SUPPLIES, OTHER
  description String
  amount      Float
  date        DateTime

  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, category])
}

model JournalEntry {
  id            String   @id @default(uuid())
  entryDate     DateTime
  description   String
  referenceType String   // SALE, REFUND, PURCHASE, EXPENSE
  referenceId   String   // ID of the related transaction, PO, or expense

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lines         JournalEntryLine[]

  createdAt     DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, entryDate])
  @@index([tenantId, referenceType])
  @@index([referenceType, referenceId])
}

model JournalEntryLine {
  id              String   @id @default(uuid())
  accountCategory String   // CASH, INVENTORY, ACCOUNTS_PAYABLE, OWNER_EQUITY, RETAINED_EARNINGS, SALES_REVENUE, COGS, OPERATING_EXPENSE
  debit           Float    @default(0)
  credit          Float    @default(0)
  label           String?  // Optional detail label (e.g., expense category name)

  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([accountCategory])
}

// ------------------------------------------------------
// Exclusive Features (Managed by Super Admin)
// ------------------------------------------------------

model ExclusiveFeature {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?  @db.Text
  category    String   @default("GENERAL")
  isActive    Boolean  @default(true)

  tenantFeatures TenantFeature[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model TenantFeature {
  id         String   @id @default(uuid())

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  featureId  String
  feature    ExclusiveFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  enabled    Boolean  @default(true)
  config     Json?

  assignedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([tenantId, featureId])
  @@index([tenantId])
  @@index([featureId])
}

// ------------------------------------------------------
// WhatsApp Notification System (Multi-Tenant, QR-Based)
// ------------------------------------------------------

model WhatsappConfig {
  id                String   @id @default(uuid())
  botName           String   @default("WhatsApp Bot")
  enabled           Boolean  @default(true)
  connectionStatus  String   @default("DISCONNECTED") // DISCONNECTED, QR_READY, CONNECTING, CONNECTED
  connectedPhone    String?  // Auto-filled after QR scan
  checkoutTemplate  String   @default("Halo {{customer_name}}! 🧾\n\nTerima kasih telah berbelanja di *{{store_name}}*.\n\nNo. Struk: {{receipt_id}}\nTanggal: {{date}}\n\n{{items}}\n\nSubtotal: {{subtotal}}\nPajak: {{tax}}\n*Total: {{total}}*\n\nMetode: {{payment_method}}\nDibayar: {{amount_paid}}\nKembalian: {{change_due}}\n\nTerima kasih atas kunjungannya! 🙏") @db.Text
  refundTemplate    String   @default("Halo {{customer_name}},\n\nPengembalian dana telah diproses untuk transaksi *{{receipt_id}}* di *{{store_name}}*.\n\n*Total Refund: {{total}}*\n\nTerima kasih. 🙏") @db.Text

  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  logs              WhatsappLog[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model WhatsappLog {
  id              String    @id @default(uuid())
  event           String    // CHECKOUT_SUCCESS, REFUND_SUCCESS
  recipientPhone  String
  recipientName   String
  messageBody     String    @db.Text
  status          String    @default("PENDING") // PENDING, SENDING, SENT, FAILED
  retryCount      Int       @default(0)
  maxRetries      Int       @default(3)
  errorMessage    String?
  sentAt          DateTime?
  nextRetryAt     DateTime?
  transactionId   String?
  transaction     Transaction? @relation(fields: [transactionId], references: [id])

  configId        String
  config          WhatsappConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([configId])
  @@index([status])
  @@index([configId, status])
  @@index([status, nextRetryAt])
}
